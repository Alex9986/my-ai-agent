CLOUDBASE_ENV_ID=
CLOUDBASE_API_KEY=
DEEPSEEK_API_KEY=

# 可选，留空即使用默认值 deepseek-flash
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役，不可再用
DEEPSEEK_MODEL=

# 可选，撤销令牌的签名密钥。
# 不填则从 DEEPSEEK_API_KEY 派生；两者都没有时用进程内随机密钥（重启后旧链接失效）
UNDO_SECRET=

# 可选，Agent 循环上限。
# AGENT_TOTAL_BUDGET_MS 是「整轮对话」的预算，必须小于部署平台的函数超时
# （Vercel 默认 10s，需要压到 8000 左右，否则多步循环会被平台掐断）
AGENT_MAX_STEPS=5
AGENT_TOTAL_BUDGET_MS=45000
# 送入模型的历史消息条数上限，超出则从最早的消息开始丢弃
AGENT_MAX_HISTORY=20
